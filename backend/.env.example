# ===== 基础设施 =====
# 运行环境：production 时启动执行安全自检（cookie_secure/enable_docs/admin_no_auth/
# 默认口令任一不合规直接拒绝启动，见 app/core/config.py 的 _assert_production_safe）
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://hjradar:hjradar@postgres:5432/hjradar
REDIS_URL=redis://redis:6379/0

# ===== LLM 服务（OpenAI 兼容 / Anthropic 原生双协议，可选）=====
# 配置后 AI 摘要与事件总结走大模型；不配置则自动使用内置抽取式算法（依然真实运行）
# LLM_PROTOCOL=openai   # openai=兼容协议；anthropic=原生 /v1/messages
#                       # （anthropic 的 base_url 不带 /v1：填 https://api.deepseek.com/anthropic、
#                       #   https://open.bigmodel.cn/api/anthropic 等网关前缀，端点由程序拼接）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=sk-xxx
# LLM_MODEL=glm-4-flash

# ===== Embedding 服务（OpenAI 兼容协议，可选）=====
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_MODEL=text-embedding-3-small

# ===== 文章生成（「AI 生成文章」草稿链路；依赖上面的 LLM 配置）=====
# 以下均可管理面板热调；草稿为全员共享（created_by 仅审计追溯，不是访问隔离）。
# 停用开关只阻止后续模型调用；已发出的请求允许完成。人工编辑标题≤30、摘要≤120 Unicode 码点（Python codepoint 口径）。
# 不配置 LLM 时生成接口会失败并提示"未配置 LLM"；未配置 article_gen_enabled 时沿用默认 true
# ARTICLE_GEN_ENABLED=true
# ARTICLE_GEN_MODEL=            # 留空跟随 LLM_MODEL；可指定便宜模型（建议上下文 ≥32k）
# ARTICLE_GEN_HOURLY_LIMIT=30   # 单用户每小时生成派发上限；0 = 不限
# ARTICLE_GEN_MAX_SOURCES=6     # 事件生文取成员报道上限
# ARTICLE_GEN_MAX_SOURCE_CHARS=4000  # 单篇素材正文截断

# ===== 向量维度 =====
EMBED_DIM=256

# ===== 事件聚合阈值（PRD：相似度 > 0.85）=====
SIM_THRESHOLD=0.85
CLUSTER_WINDOW_HOURS=48
CLUSTER_LOOKBACK_HOURS=96
# 高位带合并的最低关键词重合（须跨来源佐证；真实数据标定见 sim_report.py）
HIGH_BAND_KW_FLOOR=0.1

# ===== 爬虫 =====
# 采集间隔可运行时修改：管理面板"运维监控 → 运行时配置"热调，无需重启
CRAWLER_INTERVAL_MINUTES=15
CRAWL_LIMIT_PER_FEED=30

# ===== 互动数据轮询（评论数/点赞数，beat 每 15 分钟一批）=====
# 范围 = IT之家 + 快科技（快科技 views/shares 无对称数据源，恒 0 不轮询，见 crawler/stats.py docstring）
# 总开关与批次可管理面板热调；分层节奏（0-2h/30min → 48h-14d/12h）为代码常量
STATS_POLL_ENABLED=true
STATS_POLL_BATCH=50
# 热度公式点赞权重：Engagement = views + comments×4 + likes×2 + shares×6（仅 env，不进面板热调）
LIKE_WEIGHT=2

# ===== 日报 Webhook 推送（企业微信 / 飞书）=====
# 推荐直接在「运维监控 → 日报推送」面板配置（DB 覆盖，热生效）；以下 .env 仅作默认值
# REPORT_PUSH_ENABLED=true
# REPORT_PUSH_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# 旧名 REPORT_PUSH_WEBHOOK_URL 仍兼容，但新名优先
# REPORT_PUSH_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# REPORT_PUSH_FEISHU_SECRET=（仅飞书机器人开启「签名校验」时需要）

# ===== 运维告警 Webhook（巡检任务每 5 分钟检查，异常推送）=====
# 推荐直接在「运维监控 → 告警通知」面板配置（DB 覆盖，热生效）；URL 留空 = 关闭
# ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# ALERT_WEBHOOK_STYLE=wecom  # wecom / dingtalk / feishu / raw

# ===== 管理面板（运维监控 + 运行时配置）=====
# 管理面板接口（/api/v2/admin/*）的鉴权 token；未设置时面板不可用
ADMIN_TOKEN=please-change-me
# 免鉴权开关：true 时面板无需 Token 直接进入。
# ⚠ 仅限本机/内网使用；部署到公网必须改为 false 并配置 ADMIN_TOKEN
ADMIN_NO_AUTH=false

# ===== 登录系统（邮箱 + 密码，全站强制登录）=====
# 首启引导：user 表为空时自动创建「默认租户 + 平台超管」；建号后可从 .env 移除这两行
# （忘记超管密码时的自救：docker compose exec backend python scripts/manage_user.py reset-password <邮箱> <新密码>）
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=please-change-me-too
# 以下键均可在管理面板「运行时配置 → 安全与会话」热调（DB 覆盖优先于 .env）
SESSION_TTL_HOURS=24         # 会话有效期（小时）；代码默认 72（OWASP 建议 4-8h 量级），生产示例取 24——原 168 放宽示例已废弃（2026-09-19），内网系统可按需再调
LOGIN_MAX_ATTEMPTS=5         # 连续登录失败锁定阈值
LOGIN_LOCK_MINUTES=15        # 锁定时长（分钟）
COOKIE_SECURE=false          # 会话 Cookie Secure 标记；HTTPS 部署必须改 true
AUDIT_RETENTION_DAYS=180     # 审计日志保留天数（beat 每周自动清理）

# ===== 安全 =====
# 允许跨域访问 API 的前端来源（逗号分隔）；不要使用 *，防止管理接口被任意网页跨域调用
CORS_ORIGINS=http://localhost,http://127.0.0.1
# 内网服务主机名精确白名单（逗号分隔）：仅这些主机的 AI/Webhook 地址豁免 SSRF 私网校验，
# 其余目标仍强制公网校验（2026-09-18 审计整改 M-2）。例：compose 内网 embedding 服务
# AI_URL_ALLOWLIST=embedding
# 已弃用：true 时全局豁免 SSRF 校验（攻击面大），仅为兼容旧部署保留；
# ENVIRONMENT=production 下开启会被启动自检直接拒绝
ALLOW_PRIVATE_AI_URLS=false
# Embedding API 失败/维度不符时是否硬失败（false = 静默降级本地哈希向量，会污染聚类）
EMBEDDING_STRICT=true

# ===== 生产部署检查单 =====
# 0. ENVIRONMENT=production：启动时自动执行安全自检（强制以下各项合规，否则拒绝启动）
# 1. 项目根目录 .env 设置强随机 POSTGRES_PASSWORD（compose 必需项，无默认回退，
#    缺失直接报错拒起；改 .env 后对已有卷需执行：
#    docker compose exec postgres psql -U hjradar -d hjradar -c "ALTER USER hjradar WITH PASSWORD '<新口令>';"）
# 2. DATABASE_URL 中的口令同步修改
# 3. ADMIN_TOKEN 换强随机值（仅作脚本应急后门）
# 4. BOOTSTRAP_ADMIN_EMAIL / BOOTSTRAP_ADMIN_PASSWORD 设置并首启完成引导（建号后可移除）
# 5. ADMIN_NO_AUTH=false 确认关闭
# 6. HTTPS 部署时 COOKIE_SECURE=true（ENVIRONMENT=production 下强制校验）
# 7. ENABLE_DOCS=false（ENVIRONMENT=production 下强制校验）
# 8. 草稿队列：保持 task_reject_on_worker_lost 默认关闭；不得为文章任务全局打开无限即时重投。
#    SIGKILL WorkerLostError 由 article_gen_task 专用失败信号在父进程做 generation CAS；
#    锁重试耗尽必须先确认 PostgreSQL advisory lock 无活动 owner，冲突时只安排一次
#    3605 秒后确认，不能抢占正在生成的合法任务。Redis visibility_timeout 仍为 4 小时。
#    父进程/数据库同时故障、确认任务失效或 hard time limit 未发 WorkerLostError 时，
#    仍需 stale 人工/API 重试入口；隔离诊断缩短的 visibility 值不代表生产恢复时延。
